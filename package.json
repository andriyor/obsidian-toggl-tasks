{
	"name": "obsidian-toggl-tasks",
	"version": "0.1.0",
	"description": "Obsidian plugin that starts Toggl Track timers from tasks and writes tracked time back to the note.",
	"main": "main.js",
	"private": true,
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"test": "node --test --experimental-strip-types test/task.test.mts",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
	},
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@e18e/eslint-plugin": "^0.8.1",
		"@types/node": "^22.20.5",
		"esbuild": "^0.28.2",
		"eslint": "^10.13.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "^1.14.4",
		"prettier": "^3.9.10",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1"
	}
}
